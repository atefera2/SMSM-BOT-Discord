  "_comment_voice": [
    "kitchen_vc = the channel the ROOM SPEAKER sits in. That device must have its microphone disabled - see the guide's audio section.",
    "Anyone who needs to TALK uses a headset on push-to-talk, never the room speaker's device.",
    "repeat_urgent = say NEED NOW and OUT announcements twice, because kitchens are loud."
  ],
  "voice": {
    "kitchen_vc": "KITCHEN SPEAKER",
    "foh_vc": "FRONT OF HOUSE SPEAKER",
    "language": "en",
    "slow": false,
    "auto_join_on_start": true,
    "attention_prefix": "Kitchen.",
    "repeat_urgent": 2,
    "speak_levels": [
      "need",
      "out",
      "low"
    ],
    "announce_incidents": true,
    "announce_supply_runs": true
  },
  "_comment_voice_input": [
    "Hold the mic button in the Discord message box, talk, release. The bot plays your recording through the kitchen speaker.",
    "play_recording = play the actual voice clip. Always works, needs nothing installed.",
    "transcribe     = ALSO convert it to text so the prep board updates and it lands in the memory bank.",
    "                 Needs faster-whisper:  ./.venv/bin/pip install faster-whisper",
    "                 Runs entirely on the laptop. No account, no API key, no audio leaves the building.",
    "model          = tiny.en (fastest) | base.en (recommended) | small.en (most accurate, slower)",
    "max_seconds    = ignore clips longer than this so nobody monopolizes the speaker."
  ],
  "voice_input": {
    "play_recording": true,
    "announce_after_recording": true,
    "transcribe": true,
    "model": "base.en",
    "language": "en",
    "target": "kitchen",
    "max_seconds": 45
  },
  "_comment_dashboard": "Big-screen dashboards served by the bot itself. Open these in a browser on the kitchen TV and the command center screen.",
  "dashboard": {
    "enabled": true,
    "port": 8080,
    "refresh_seconds": 2,
    "kitchen_columns": 4,
    "stale_minutes": 45
  },
  "behavior": {
    "board_refresh_seconds": 20,
    "request_cooldown_seconds": 0,
    "admin_requires_role": [
      "Ops Manager",
      "Festival Lead"
    ],
    "nag_minutes": 7,
    "nag_max": 3,
    "overdue_grace_minutes": 3,
    "announce_overdue": true,
    "max_spoken_items": 5
  }
}